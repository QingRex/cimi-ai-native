diff --git a/src/ninja.cc b/src/ninja.cc
index 92d0761..8670912 100644
--- a/src/ninja.cc
+++ b/src/ninja.cc
@@ -1802,0 +1803,14 @@ NORETURN void real_main(int argc, char** argv) {
+#ifdef _WIN32
+  // Keep the same directory while avoiding Win32's pre-normalization limit
+  // for long relative source paths. Do not create aliases or mappings.
+  string short_working_dir;
+  if (options.working_dir) {
+    vector<char> buffer(32768);
+    DWORD size = GetShortPathNameA(options.working_dir, &buffer[0],
+                                   static_cast<DWORD>(buffer.size()));
+    if (size > 0 && size < buffer.size()) {
+      short_working_dir.assign(&buffer[0], size);
+      options.working_dir = short_working_dir.c_str();
+    }
+  }
+#endif
