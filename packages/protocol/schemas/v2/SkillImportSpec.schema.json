{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "SkillImportSpec.v2",
  "type": "object",
  "required": [
    "format",
    "repository_url",
    "commit_id",
    "entry_path",
    "license_path",
    "name",
    "version",
    "modules",
    "capabilities",
    "provider_dependencies",
    "required_permissions",
    "harness_requirements",
    "dependency_review"
  ],
  "properties": {
    "format": {
      "type": "string",
      "const": "cimiloop/skill-import/1.0.0"
    },
    "repository_url": {
      "type": "string",
      "pattern": "^https://[A-Za-z0-9.-]+/[A-Za-z0-9_./-]+$",
      "maxLength": 500
    },
    "commit_id": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "entry_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
    },
    "license_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "dependencies"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "^[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240,
              "pattern": "^[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
            },
            "uniqueItems": true,
            "maxItems": 32
          }
        },
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 32
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "capability_id",
          "version"
        ],
        "properties": {
          "capability_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$"
          },
          "version": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
          }
        },
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true
    },
    "provider_dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "descriptor_ref",
          "digest"
        ],
        "properties": {
          "descriptor_ref": {
            "type": "object",
            "required": [
              "object_type",
              "id"
            ],
            "properties": {
              "object_type": {
                "type": "string",
                "const": "provider_descriptor"
              },
              "id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              }
            },
            "additionalProperties": false
          },
          "digest": {
            "type": "object",
            "required": [
              "algorithm",
              "value"
            ],
            "properties": {
              "algorithm": {
                "type": "string",
                "const": "sha256"
              },
              "value": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      "maxItems": 32,
      "uniqueItems": true
    },
    "required_permissions": {
      "type": "object",
      "required": [
        "actions",
        "resources",
        "environment_ids",
        "network_hosts"
      ],
      "properties": {
        "actions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "resources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "provider",
              "resource_type",
              "locator"
            ],
            "properties": {
              "provider": {
                "type": "string",
                "minLength": 1
              },
              "resource_type": {
                "type": "string",
                "minLength": 1
              },
              "locator": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "digest": {
                "type": "object",
                "required": [
                  "algorithm",
                  "value"
                ],
                "properties": {
                  "algorithm": {
                    "type": "string",
                    "const": "sha256"
                  },
                  "value": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          "uniqueItems": true
        },
        "environment_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "uniqueItems": true
        },
        "network_hosts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "harness_requirements": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$",
        "maxLength": 100
      },
      "maxItems": 32,
      "uniqueItems": true
    },
    "dependency_review": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    }
  },
  "additionalProperties": false
}
