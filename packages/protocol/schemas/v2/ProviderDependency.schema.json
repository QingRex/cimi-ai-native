{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ProviderDependency.v2",
  "type": "object",
  "required": [
    "descriptor_ref",
    "digest"
  ],
  "properties": {
    "descriptor_ref": {
      "type": "object",
      "required": [
        "object_type",
        "id"
      ],
      "properties": {
        "object_type": {
          "type": "string",
          "const": "provider_descriptor"
        },
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        }
      },
      "additionalProperties": false
    },
    "digest": {
      "type": "object",
      "required": [
        "algorithm",
        "value"
      ],
      "properties": {
        "algorithm": {
          "type": "string",
          "const": "sha256"
        },
        "value": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
