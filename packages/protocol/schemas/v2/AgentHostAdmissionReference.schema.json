{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "AgentHostAdmissionReference.v2",
  "type": "object",
  "required": [
    "provider",
    "resource_type",
    "locator",
    "digest"
  ],
  "properties": {
    "provider": {
      "type": "string",
      "const": "local_content"
    },
    "resource_type": {
      "type": "string",
      "const": "agent_host_admission"
    },
    "locator": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "digest": {
      "type": "object",
      "required": [
        "algorithm",
        "value"
      ],
      "properties": {
        "algorithm": {
          "type": "string",
          "const": "sha256"
        },
        "value": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
