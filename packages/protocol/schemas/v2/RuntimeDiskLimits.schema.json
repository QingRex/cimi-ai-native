{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "RuntimeDiskLimits.v2",
  "type": "object",
  "required": [
    "max_sandbox_bytes",
    "max_sandbox_entries",
    "max_file_bytes",
    "max_output_bytes"
  ],
  "properties": {
    "max_sandbox_bytes": {
      "type": "integer",
      "minimum": 65536,
      "maximum": 268435456
    },
    "max_sandbox_entries": {
      "type": "integer",
      "minimum": 4,
      "maximum": 1024
    },
    "max_file_bytes": {
      "type": "integer",
      "minimum": 65536,
      "maximum": 16777216
    },
    "max_output_bytes": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 16777216
    }
  },
  "additionalProperties": false
}
