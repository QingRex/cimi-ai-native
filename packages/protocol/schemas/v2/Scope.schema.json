{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "Scope.v2",
  "type": "object",
  "required": [
    "kind",
    "id"
  ],
  "properties": {
    "kind": {
      "anyOf": [
        {
          "type": "string",
          "const": "project"
        },
        {
          "type": "string",
          "const": "change"
        },
        {
          "type": "string",
          "const": "release_batch"
        },
        {
          "type": "string",
          "const": "environment"
        }
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  },
  "additionalProperties": false
}
