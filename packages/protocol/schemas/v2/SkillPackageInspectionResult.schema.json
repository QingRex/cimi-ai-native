              "minLength": 1,
              "maxLength": 240,
              "pattern": "^[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 32
    },
    "file_count": {
