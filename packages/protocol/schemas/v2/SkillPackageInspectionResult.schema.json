                "properties": {
                  "provider": {
                    "type": "string",
                    "minLength": 1
                  },
                  "resource_type": {
                    "type": "string",
                    "minLength": 1
                  },
                  "locator": {
                    "type": "string",
                    "minLength": 1
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1
                  },
                  "digest": {
                    "type": "object",
                    "required": [
                      "algorithm",
                      "value"
                    ],
                    "properties": {
                      "algorithm": {
                        "type": "string",
                        "const": "sha256"
                      },
                      "value": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "additionalProperties": false
              },
              "uniqueItems": true
            },
            "environment_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              "uniqueItems": true
            },
            "network_hosts": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        },
        "harness_requirements": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$",
            "maxLength": 100
          },
          "maxItems": 32,
          "uniqueItems": true
        },
        "dependency_review": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      },
      "additionalProperties": false
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
