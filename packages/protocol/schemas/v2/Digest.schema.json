{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "Digest.v2",
  "type": "object",
  "required": [
    "algorithm",
    "value"
  ],
  "properties": {
    "algorithm": {
      "type": "string",
      "const": "sha256"
    },
    "value": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false
}
