{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "CapabilityReference.v2",
  "type": "object",
  "required": [
    "capability_id",
    "version"
  ],
  "properties": {
    "capability_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    }
  },
  "additionalProperties": false
}
