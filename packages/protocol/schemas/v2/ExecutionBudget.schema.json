{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ExecutionBudget.v2",
  "type": "object",
  "required": [
    "max_attempts",
    "max_elapsed_ms"
  ],
  "properties": {
    "max_attempts": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "max_elapsed_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "max_cost": {
      "type": "object",
      "required": [
        "currency",
        "amount_micros"
      ],
      "properties": {
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "amount_micros": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
