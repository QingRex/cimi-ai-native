{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "AgentToolAuthorityRequest.v2",
  "type": "object",
  "required": [
    "project_id",
    "run_id",
    "operation_key",
    "executor_actor_id",
    "context_digest",
    "action",
    "resource",
    "runtime_binding",
    "skill_bindings",
    "host_admission_ref"
  ],
  "properties": {
    "project_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "operation_key": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "executor_actor_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "context_digest": {
      "type": "object",
      "required": [
        "algorithm",
        "value"
      ],
      "properties": {
        "algorithm": {
          "type": "string",
          "const": "sha256"
        },
        "value": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "action": {
      "anyOf": [
        {
          "type": "string",
          "const": "read_files"
        },
        {
          "type": "string",
          "const": "edit_files"
        },
        {
          "type": "string",
          "const": "run_checks"
        }
      ]
    },
    "resource": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "runtime_binding": {
      "type": "object",
      "required": [
        "binding_ref",
        "digest"
      ],
      "properties": {
        "binding_ref": {
          "type": "object",
          "required": [
            "object_type",
            "id"
          ],
          "properties": {
            "object_type": {
              "type": "string",
              "const": "provider_binding"
            },
            "id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            }
          },
          "additionalProperties": false
        },
        "digest": {
          "type": "object",
          "required": [
            "algorithm",
            "value"
          ],
          "properties": {
            "algorithm": {
              "type": "string",
              "const": "sha256"
            },
            "value": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "skill_bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "binding_ref",
          "digest"
        ],
        "properties": {
          "binding_ref": {
            "type": "object",
            "required": [
              "object_type",
              "id"
            ],
            "properties": {
              "object_type": {
                "type": "string",
                "const": "provider_binding"
              },
              "id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              }
            },
            "additionalProperties": false
          },
          "digest": {
            "type": "object",
            "required": [
              "algorithm",
              "value"
            ],
            "properties": {
              "algorithm": {
                "type": "string",
                "const": "sha256"
              },
              "value": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      "maxItems": 8,
      "uniqueItems": true
    },
    "host_admission_ref": {
      "type": "object",
      "required": [
        "provider",
        "resource_type",
        "locator",
        "digest"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "const": "local_content"
        },
        "resource_type": {
          "type": "string",
          "const": "agent_host_admission"
        },
        "locator": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "digest": {
          "type": "object",
          "required": [
            "algorithm",
            "value"
          ],
          "properties": {
            "algorithm": {
              "type": "string",
              "const": "sha256"
            },
            "value": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
