{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "NamedSkillMethodSample.v2",
  "type": "object",
  "required": [
    "invocation_key",
    "input_ref",
    "transcript_ref",
    "stdout_ref",
    "native_proof_ref"
  ],
  "properties": {
    "invocation_key": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,95}$"
    },
    "input_ref": {
      "type": "object",
      "required": [
        "provider",
        "resource_type",
        "locator",
        "digest"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "const": "local_content"
        },
        "resource_type": {
          "type": "string",
          "const": "skill_method_input"
        },
        "locator": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "digest": {
          "type": "object",
          "required": [
            "algorithm",
            "value"
          ],
          "properties": {
            "algorithm": {
              "type": "string",
              "const": "sha256"
            },
            "value": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "transcript_ref": {
      "type": "object",
      "required": [
        "provider",
        "resource_type",
        "locator",
        "digest"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "const": "local_content"
        },
        "resource_type": {
          "type": "string",
          "const": "provider_probe_artifact"
        },
        "locator": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "digest": {
          "type": "object",
          "required": [
            "algorithm",
            "value"
          ],
          "properties": {
            "algorithm": {
              "type": "string",
              "const": "sha256"
            },
            "value": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "additionalProperties": false
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "stdout_ref": {
      "type": "object",
      "required": [
        "provider",
        "resource_type",
        "locator",
        "digest"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "const": "local_content"
        },
        "resource_type": {
          "type": "string",
          "const": "provider_probe_artifact"
        },
        "locator": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "digest": {
          "type": "object",
          "required": [
            "algorithm",
            "value"
          ],
          "properties": {
            "algorithm": {
              "type": "string",
              "const": "sha256"
            },
            "value": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "additionalProperties": false
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "native_proof_ref": {
      "type": "object",
      "required": [
        "provider",
        "resource_type",
        "locator",
        "digest"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "const": "local_content"
        },
        "resource_type": {
          "type": "string",
          "const": "provider_probe_artifact"
        },
        "locator": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "digest": {
          "type": "object",
          "required": [
            "algorithm",
            "value"
          ],
          "properties": {
            "algorithm": {
              "type": "string",
              "const": "sha256"
            },
            "value": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "additionalProperties": false
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
