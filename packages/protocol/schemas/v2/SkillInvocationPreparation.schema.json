{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "SkillInvocationPreparation.v2",
  "type": "object",
  "required": [
    "request",
    "package_ref",
    "input_schema_ref",
    "output_schema_ref",
    "method_qualification_ref"
  ],
  "properties": {
    "request": {
      "type": "object",
      "required": [
        "format",
        "invocation_key",
        "method_name",
        "source_digest",
        "input"
      ],
      "properties": {
        "format": {
          "type": "string",
          "const": "cimiloop/named-skill-method/1.0.0"
        },
        "invocation_key": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,95}$"
        },
        "method_name": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 64
        },
        "source_digest": {
          "type": "object",
          "required": [
            "algorithm",
            "value"
          ],
          "properties": {
            "algorithm": {
              "type": "string",
              "const": "sha256"
            },
            "value": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "additionalProperties": false
        },
        "input": {
          "anyOf": [
            {
              "type": "object",
              "required": [
                "purpose",
                "requirement",
                "background",
                "constraints"
              ],
              "properties": {
                "purpose": {
                  "type": "string",
                  "const": "clarification"
                },
                "requirement": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                },
                "background": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                },
                "constraints": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000
                  },
                  "maxItems": 64,
                  "uniqueItems": true
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "purpose",
                "goal",
                "spec",
                "standards",
                "artifact_refs"
              ],
              "properties": {
                "purpose": {
                  "type": "string",
                  "const": "review"
                },
                "goal": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                },
                "spec": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                },
                "standards": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                },
                "artifact_refs": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "provider",
                      "resource_type",
                      "locator"
                    ],
                    "properties": {
                      "provider": {
                        "type": "string",
                        "minLength": 1
                      },
                      "resource_type": {
                        "type": "string",
                        "minLength": 1
                      },
                      "locator": {
                        "type": "string",
                        "minLength": 1
                      },
                      "version": {
                        "type": "string",
                        "minLength": 1
                      },
                      "digest": {
                        "type": "object",
                        "required": [
                          "algorithm",
                          "value"
                        ],
                        "properties": {
                          "algorithm": {
                            "type": "string",
                            "const": "sha256"
                          },
                          "value": {
                            "type": "string",
                            "pattern": "^[0-9a-f]{64}$"
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "additionalProperties": false
                  },
                  "minItems": 1,
                  "maxItems": 64,
                  "uniqueItems": true
                }
              },
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "package_ref": {
      "type": "object",
      "required": [
        "provider",
        "resource_type",
        "locator",
        "digest"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "const": "local_content"
        },
        "resource_type": {
          "type": "string",
          "const": "skill_package"
        },
        "locator": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "digest": {
          "type": "object",
          "required": [
            "algorithm",
            "value"
          ],
          "properties": {
            "algorithm": {
              "type": "string",
              "const": "sha256"
            },
            "value": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "input_schema_ref": {
      "type": "object",
      "required": [
        "schema_id",
        "digest"
      ],
      "properties": {
        "schema_id": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "object",
          "required": [
            "algorithm",
            "value"
          ],
          "properties": {
            "algorithm": {
              "type": "string",
              "const": "sha256"
            },
            "value": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "output_schema_ref": {
      "type": "object",
      "required": [
        "schema_id",
        "digest"
      ],
      "properties": {
        "schema_id": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "object",
          "required": [
            "algorithm",
            "value"
          ],
          "properties": {
            "algorithm": {
              "type": "string",
              "const": "sha256"
            },
            "value": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "method_qualification_ref": {
      "type": "object",
      "required": [
        "provider",
        "resource_type",
        "locator",
        "digest"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "const": "local_content"
        },
        "resource_type": {
          "type": "string",
          "const": "skill_method_qualification"
        },
        "locator": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "digest": {
          "type": "object",
          "required": [
            "algorithm",
            "value"
          ],
          "properties": {
            "algorithm": {
              "type": "string",
              "const": "sha256"
            },
            "value": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
