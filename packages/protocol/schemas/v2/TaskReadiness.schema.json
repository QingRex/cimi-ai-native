{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "TaskReadiness.v2",
  "type": "object",
  "required": [
    "task_id",
    "ready",
    "reasons",
    "usage_digest",
    "budget_remaining"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "ready": {
      "type": "boolean"
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "usage_digest": {
      "type": "object",
      "required": [
        "algorithm",
        "value"
      ],
      "properties": {
        "algorithm": {
          "type": "string",
          "const": "sha256"
        },
        "value": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "budget_remaining": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "attempts",
            "elapsed_ms",
            "cost_micros"
          ],
          "properties": {
            "attempts": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "elapsed_ms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "cost_micros": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false
}
