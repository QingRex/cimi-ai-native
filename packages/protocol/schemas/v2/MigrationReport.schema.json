{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "MigrationReport.v2",
  "type": "object",
  "required": [
    "schema_version",
    "ok",
    "mode",
    "from_format",
    "to_format",
    "migration_required",
    "counts"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "2.0.0"
    },
    "ok": {
      "type": "boolean",
      "const": true
    },
    "mode": {
      "anyOf": [
        {
          "type": "string",
          "const": "check"
        },
        {
          "type": "string",
          "const": "apply"
        }
      ]
    },
    "from_format": {
      "type": "integer",
      "minimum": 1
    },
    "to_format": {
      "anyOf": [
        {
          "type": "number",
          "const": 2
        },
        {
          "type": "number",
          "const": 3
        },
        {
          "type": "number",
          "const": 4
        },
        {
          "type": "number",
          "const": 5
        },
        {
          "type": "number",
          "const": 6
        },
        {
          "type": "number",
          "const": 7
        },
        {
          "type": "number",
          "const": 8
        },
        {
          "type": "number",
          "const": 9
        }
      ]
    },
    "migration_required": {
      "type": "boolean"
    },
    "counts": {
      "type": "object",
      "patternProperties": {
        "^.*$": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "backup_path": {
      "type": "string",
      "minLength": 1
    },
    "backup_digest": {
      "type": "object",
      "required": [
        "algorithm",
        "value"
      ],
      "properties": {
        "algorithm": {
          "type": "string",
          "const": "sha256"
        },
        "value": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "migration_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  },
  "additionalProperties": false
}
