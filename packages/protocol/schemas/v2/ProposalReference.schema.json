{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ProposalReference.v2",
  "anyOf": [
    {
      "type": "object",
      "required": [
        "object_type",
        "id",
        "domain_version"
      ],
      "properties": {
        "object_type": {
          "type": "string",
          "const": "contract_proposal"
        },
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "domain_version": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "object_type",
        "id",
        "domain_version"
      ],
      "properties": {
        "object_type": {
          "type": "string",
          "const": "plan_proposal"
        },
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "domain_version": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    }
  ]
}
